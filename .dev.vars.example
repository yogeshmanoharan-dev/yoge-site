# Documentation only until the Phase 1/3 runtime configuration is implemented.
# Copy to .dev.vars when instructed; .dev.vars is ignored by Git.
# Fill secrets locally or in the appropriate Cloudflare environment, never in chat.
# Empty values are intentional. There are no working credentials in this file.

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_SECRET=
IP_HASH_SECRET=
TURNSTILE_SECRET_KEY=
ALERT_EMAIL_TO=

# Optional: email alerts remain disabled without this key.
RESEND_API_KEY=

# Public configuration; bind these in the future Wrangler configuration.
ADMIN_GITHUB_USER_IDS=
TURNSTILE_SITE_KEY=
PUBLIC_SITE_URL=http://localhost:4321

# CF_API_TOKEN and CF_ACCOUNT_ID belong in GitHub Actions secrets for deployment.
# Never use the production database or production credentials in local tests.
