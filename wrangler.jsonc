{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yoge-site-local",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": { "APP_ENV": "local" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yoge-site-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  "env": {
    "preview": {
      "name": "yoge-site-preview",
      "workers_dev": true,
      "preview_urls": true,
      "vars": { "APP_ENV": "preview" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "yoge-site-preview",
          "database_id": "8733b468-0277-477c-9991-bb56ca04a01e",
        },
      ],
    },
    "production": {
      "name": "yoge-site",
      "workers_dev": true,
      "preview_urls": false,
      "vars": { "APP_ENV": "production" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "yoge-site",
          "database_id": "c085ce13-8452-434f-a330-e28fe04791f3",
        },
      ],
    },
  },
}
