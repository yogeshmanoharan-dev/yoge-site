---
import BaseLayout from '../layouts/BaseLayout.astro';
import { brand } from '../lib/brand';

const github = 'https://github.com/yogeshmanoharan-dev';
const linkedin = 'https://www.linkedin.com/in/yogesh-manoharan-5512a144b';
const headlineSentences = brand.heroHeadline.split(/(?<=\.) /);
---

<BaseLayout
  title="Yoge — Yogesh Manoharan"
  description="Yogesh Manoharan, known as Yoge. Designer turned AI creator, explaining AI concepts, testing tools, and building with AI."
>
  <link
    slot="head"
    rel="preload"
    href="/fonts/instrument-serif-latin.woff2"
    as="font"
    type="font/woff2"
    crossorigin
  />
  <header class="site-header page-shell">
    <a class="wordmark" href="/" aria-label="Yoge home">
      yoge.
    </a>
    <p class="header-note">
      Independent thinking.
      <br />A designer’s perspective.
    </p>
    <nav aria-label="Main navigation">
      <a href="#about">About</a>
      <a href={github} rel="me noreferrer">
        GitHub <span aria-hidden="true">↗</span>
      </a>
      <a class="header-contact" href="#connect">
        Say hello <span aria-hidden="true">↗</span>
      </a>
    </nav>
  </header>
  <main id="main-content" tabindex="-1">
    <section class="hello page-shell" aria-labelledby="hello-heading">
      <div class="hello-copy">
        <p class="identity">
          Yogesh Manoharan <span>Designer turned AI creator</span>
        </p>
        <h1 id="hello-heading">
          {headlineSentences.map((sentence) => (
            <span>{sentence} </span>
          ))}
        </h1>
        <p class="introduction">{brand.heroSubline}</p>
        <div class="hero-actions">
          <a
            class="primary-link"
            href={github}
            rel="me noreferrer"
            aria-label="Explore my work on GitHub"
          >
            {brand.primaryCta}
            <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href="#about">
            A little about me <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>
      <figure class="hero-portrait">
        <img
          src="/images/portraits/yoge-monochrome-800.webp"
          srcset="/images/portraits/yoge-monochrome-480.webp 480w, /images/portraits/yoge-monochrome-800.webp 800w, /images/portraits/yoge-monochrome-1120.webp 1120w"
          sizes="(max-width: 700px) calc(100vw - 80px), (max-width: 1000px) 40vw, 520px"
          width="1120"
          height="1400"
          alt="Black-and-white portrait of Yogesh Manoharan."
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <figcaption>
          <span>Yoge</span>
          <span>Based in India</span>
        </figcaption>
      </figure>
      <div class="signal-band">
        <p>
          A designer’s eye.
          <br />
          An AI creator’s curiosity.
        </p>
        <p class="disciplines">Explain. Test. Build.</p>
      </div>
    </section>
    <section id="about" class="about-section page-shell" aria-labelledby="about-heading">
      <div class="about-heading">
        <p class="section-label">A little about me</p>
        <h2 id="about-heading">
          Design is where
          <br />I started.
          <br />
          Curiosity keeps
          <br />
          me building.
        </h2>
      </div>
      <div class="about-story">
        {brand.aboutParagraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        <a class="text-link" href={linkedin} rel="me noreferrer">
          Find me on LinkedIn <span aria-hidden="true">↗</span>
        </a>
      </div>
      <figure class="work-portrait">
        <img
          src="/images/portraits/yoge-at-work-800.webp"
          srcset="/images/portraits/yoge-at-work-480.webp 480w, /images/portraits/yoge-at-work-800.webp 800w, /images/portraits/yoge-at-work-1120.webp 1024w"
          sizes="(max-width: 700px) calc(100vw - 48px), (max-width: 1000px) 50vw, 720px"
          width="1024"
          height="1536"
          alt="Yoge working on a laptop at a wooden desk."
          loading="lazy"
          decoding="async"
        />
        <figcaption>A designer’s perspective, applied to AI.</figcaption>
      </figure>
      <p class="about-note">
        Clear explainers.
        <br />
        Honest tool tests.
        <br />
        Practical tutorials.
      </p>
    </section>
    <section id="connect" class="connect-section" aria-labelledby="connect-heading">
      <div class="page-shell connect-inner">
        <div>
          <p class="section-label">Keep in touch</p>
          <h2 id="connect-heading">Let’s compare notes.</h2>
        </div>
        <div class="connect-links">
          <a href={linkedin} rel="me noreferrer">
            Say hello on LinkedIn <span aria-hidden="true">↗</span>
          </a>
          <a href={github} rel="me noreferrer">
            Follow along on GitHub <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>
  </main>
  <footer class="site-footer page-shell">
    <a class="wordmark" href="#" aria-label="Yoge, back to top">
      yoge.
    </a>
    <p>Building with AI. Sharing along the way.</p>
    <p>Built by Yoge with AI tools</p>
  </footer>
</BaseLayout>

<style>
  .site-header {
    display: flex;
    align-items: center;
    gap: 48px;
    min-height: 120px;
    border-bottom: 1px solid var(--rule);
  }
  .wordmark {
    font-family: var(--font-display);
    font-size: 52px;
    font-weight: 400;
    letter-spacing: -3px;
    line-height: 1;
    text-decoration: none;
  }
  .header-note {
    color: var(--ink-muted);
    font-size: 12px;
    line-height: 1.6;
  }
  .site-header nav {
    display: flex;
    align-items: center;
    gap: 32px;
    margin-left: auto;
    font-size: 13px;
  }
  .site-header nav a {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    text-decoration: none;
  }
  .site-header nav a:hover {
    text-decoration: underline;
  }
  .header-contact {
    border-bottom: 1px solid var(--ink);
  }
  .hello {
    position: relative;
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 0 40px;
    padding-top: 56px;
  }
  .hello-copy {
    padding-block: 8px 48px;
  }
  .identity {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 24px;
    margin: 0 0 32px;
    font-size: 12px;
    line-height: 1.6;
  }
  .identity span {
    color: var(--ink-muted);
  }
  h1 {
    margin: 0 0 28px -0.035em;
    font-family: var(--font-display);
    font-size: clamp(64px, 7.1vw, 104px);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.035em;
  }
  h1 span {
    display: block;
    text-wrap: balance;
  }
  .introduction {
    max-width: 43ch;
    margin: 0;
    color: var(--ink-muted);
    font-size: 16px;
    line-height: 1.75;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-top: 28px;
  }
  .primary-link,
  .text-link {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 48px;
    font-size: 13px;
    text-decoration: none;
  }
  .primary-link {
    padding: 8px 20px;
    background: var(--ink);
    color: var(--paper-raised);
    border: 1px solid var(--ink);
  }
  .primary-link:hover {
    background: var(--paper);
    color: var(--ink);
  }
  .text-link {
    text-decoration: underline;
  }
  .hero-portrait {
    position: relative;
    z-index: 1;
    grid-column: 2;
    grid-row: 1 / 3;
    align-self: stretch;
    margin: 0 24px 24px 0;
    background: var(--charcoal);
    color: var(--paper-raised);
    display: flex;
    flex-direction: column;
  }
  .hero-portrait img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
    flex: 1;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 35%;
  }
  .hero-portrait figcaption {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 20px;
    font-size: 12px;
    line-height: 1.5;
  }
  .signal-band {
    grid-column: 1 / -1;
    grid-row: 2;
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 120px;
    padding: 24px 32px;
    background: var(--signal);
    color: var(--ink);
  }
  .signal-band p {
    margin: 0;
    font-size: 11px;
    line-height: 1.5;
  }
  .signal-band .disciplines {
    font-size: clamp(18px, 2vw, 28px);
    font-weight: 500;
    letter-spacing: -0.05em;
  }
  .about-section {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 56px 80px;
    padding-block: 128px;
    scroll-margin-top: 32px;
  }
  .section-label {
    margin: 0 0 32px;
    font-size: 12px;
    line-height: 1.5;
  }
  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(44px, 4.5vw, 64px);
    letter-spacing: -0.025em;
    line-height: 1.05;
  }
  .about-story {
    align-self: center;
    max-width: 52ch;
    padding-top: 40px;
  }
  .about-story p {
    margin: 0 0 24px;
    color: var(--ink-muted);
    font-size: 17px;
    line-height: 1.85;
  }
  .work-portrait {
    grid-column: 2;
    margin: 0;
  }
  .work-portrait img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: center 42%;
  }
  .work-portrait figcaption {
    margin-top: 16px;
    color: var(--ink-muted);
    font-size: 12px;
  }
  .about-note {
    grid-column: 1;
    grid-row: 2;
    align-self: end;
    margin: 0 0 32px;
    font-size: 15px;
    line-height: 1.8;
  }
  .connect-section {
    color: var(--paper);
    background: var(--charcoal);
  }
  .connect-inner {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 40px;
    padding-block: 80px;
  }
  .connect-inner .section-label {
    color: var(--dark-muted);
    margin-bottom: 24px;
  }
  .connect-links {
    width: 300px;
    flex-shrink: 0;
  }
  .connect-links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 56px;
    border-bottom: 1px solid var(--border-strong);
    font-size: 14px;
    text-decoration: none;
  }
  .connect-links a:hover {
    text-decoration: underline;
  }
  .connect-links a:focus-visible {
    outline-color: var(--signal);
  }
  .site-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    min-height: 140px;
  }
  .site-footer p {
    color: var(--ink-muted);
    font-size: 12px;
    line-height: 1.5;
  }
  @media (max-width: 1000px) {
    .header-note {
      display: none;
    }
    .hello {
      grid-template-columns: 6fr 5fr;
      gap: 0 24px;
    }
    h1 {
      font-size: clamp(58px, 7.5vw, 76px);
    }
    .hero-portrait {
      margin-right: 16px;
      margin-bottom: 16px;
    }
    .signal-band {
      gap: 16px;
      padding-inline: 24px;
    }
    .signal-band > p:first-child {
      display: none;
    }
    .about-section {
      gap: 40px;
      padding-block: 96px;
    }
    .about-story {
      padding-top: 0;
    }
    .connect-inner {
      align-items: start;
    }
    .connect-links {
      width: 260px;
    }
  }
  @media (max-width: 700px) {
    .site-header {
      min-height: 96px;
      gap: 16px;
    }
    .wordmark {
      font-size: 44px;
    }
    .site-header nav {
      gap: 20px;
      font-size: 12px;
    }
    .site-header nav > a:nth-child(2) {
      display: none;
    }
    .hello {
      grid-template-columns: 1fr;
      padding-top: 36px;
    }
    .hello-copy {
      padding-block: 0 36px;
    }
    .identity {
      display: block;
      margin-bottom: 28px;
    }
    .identity span {
      display: block;
      margin-top: 4px;
    }
    h1 {
      font-size: clamp(52px, 12.8vw, 80px);
      margin-bottom: 24px;
    }
    .introduction {
      font-size: 15px;
    }
    .hero-actions {
      gap: 12px 20px;
      margin-top: 24px;
    }
    .hero-portrait {
      grid-column: 1;
      grid-row: 2;
      margin: 0 16px 0;
    }
    .hero-portrait img {
      height: auto;
      aspect-ratio: 4 / 4.6;
      max-height: 620px;
      flex: none;
    }
    .hero-portrait figcaption {
      padding: 16px;
    }
    .signal-band {
      grid-column: 1;
      grid-row: 2 / 4;
      align-items: end;
      margin-top: 50%;
      padding: 24px 16px;
    }
    .signal-band .disciplines {
      margin-top: 24px;
      font-size: 25px;
    }
    .hello::after {
      content: '';
      grid-column: 1;
      grid-row: 3;
      height: 80px;
    }
    .about-section {
      grid-template-columns: 1fr;
      gap: 32px;
      padding-block: 72px;
    }
    .section-label {
      margin-bottom: 24px;
    }
    h2 {
      font-size: 48px;
    }
    .about-story p {
      font-size: 16px;
      line-height: 1.8;
    }
    .work-portrait {
      grid-column: 1;
    }
    .work-portrait img {
      aspect-ratio: 4 / 5;
      object-position: center 62%;
    }
    .about-note {
      display: none;
    }
    .connect-inner {
      flex-direction: column;
      padding-block: 56px;
      gap: 28px;
    }
    .connect-links {
      width: 100%;
    }
    .site-footer {
      flex-wrap: wrap;
      gap: 8px 20px;
      padding-block: 32px;
    }
    .site-footer .wordmark {
      flex-basis: 100%;
      margin-bottom: 16px;
    }
    .site-footer p {
      margin: 0;
    }
  }
</style>
