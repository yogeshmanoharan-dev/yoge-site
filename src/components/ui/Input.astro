---
import type { HTMLAttributes } from 'astro/types';
import '../../styles/components.css';

interface Props extends HTMLAttributes<'input'> {
  id: string;
  name: string;
  label: string;
  hint?: string;
  error?: string;
}
const {
  id,
  name,
  label,
  hint,
  error,
  required,
  class: className,
  'aria-describedby': describedBy,
  ...attributes
} = Astro.props;
const descriptions =
  [describedBy, hint && `${id}-hint`, error && `${id}-error`].filter(Boolean).join(' ') ||
  undefined;
---

<div class:list={['ui-field', className]}>
  <label class="ui-field__label" for={id}>
    {label}
    {required && <span class="ui-field__required"> (required)</span>}
  </label>
  {hint && (
    <p class="ui-field__hint" id={`${id}-hint`}>
      {hint}
    </p>
  )}
  <input
    {...attributes}
    id={id}
    name={name}
    required={required}
    class="ui-field__control"
    aria-invalid={error ? 'true' : undefined}
    aria-describedby={descriptions}
  />
  {error && (
    <p class="ui-field__error" id={`${id}-error`}>
      <span aria-hidden="true">!</span> {error}
    </p>
  )}
</div>
