---
import ReviewLayout from './ReviewLayout.astro';
import { brand } from '../lib/brand';
interface Props {
  option: 'a' | 'b';
}
const { option } = Astro.props;
const isA = option === 'a';
// Owner approved Font B, Hero B, and the remaining copy on 2026-11-14.
---

<ReviewLayout title={`Type ${option.toUpperCase()}`} option={option}>
  <section class="specimen-hero page-shell paper-texture">
    <div>
      <span class="mono-label">YOGESH MANOHARAN — YOGE</span>
      <h1 class="display-type">{brand.heroHeadline}</h1>
      <p>
        Designer turned AI creator. I break down AI concepts, test AI tools on real tasks, and share
        what I build along the way.
      </p>
      <div class="review-type-links">
        <a href="#about-specimen">Read the about draft</a>
        <a href={isA ? '/styleguide/type-b' : '/styleguide/type-a'}>
          Compare type {isA ? 'B' : 'A'}
        </a>
      </div>
    </div>
    <aside class="specimen-aside">
      <h2>
        Type {option.toUpperCase()}
        {!isA ? ' — selected' : ''}
      </h2>
      <p>{isA ? 'Fraunces + Inter' : 'Instrument Serif + Geist'}</p>
      <p>
        {isA
          ? 'Warm, sculptural letterforms with a clear, practical reading voice.'
          : 'A slender editorial serif with a quiet, contemporary reading voice.'}
      </p>
      <p class="mono-label">JetBrains Mono for labels</p>
    </aside>
  </section>
  <div class="specimen-rule page-shell mono-label">
    <span>Font specimen / same copy, different type</span>
    <span>Hero B selected / copy approved</span>
  </div>
  <section id="about-specimen" class="review-section page-shell review-columns">
    <h2 class="heading-type">
      A designer’s eye.
      <br />
      An AI creator’s curiosity.
    </h2>
    <div class="reading-copy flow">
      <p>
        I'm Yoge — Yogesh Manoharan, based in India. I started out as a freelance designer on Fiverr
        and Upwork. Today I create AI content: clear explainers, honest tool tests and practical
        tutorials. And I build with AI along the way.
      </p>
      <p>
        My design background shapes how I look at AI: who it's for, where the experience breaks, and
        whether it actually solves a problem.
      </p>
    </div>
  </section>
  <section class="surface-dark dark-section">
    <div class="page-shell">
      <h2 class="heading-type">
        Building with AI.
        <br />
        Sharing what actually works.
      </h2>
      <p class="reading-copy" style="margin-top:24px">
        Selected hero headline B. The brand-statement option is reserved until a live AI product is
        published.
      </p>
    </div>
  </section>
  <section class="review-section page-shell">
    <h2 class="mono-label">Letterforms & numbers</h2>
    <p class="specimen-alphabet">
      Aa Bb Cc Dd Ee Ff Gg Hh Ii Jj Kk Ll Mm Nn Oo Pp Qq Rr Ss Tt Uu Vv Ww Xx Yy Zz
      <br />
      0123456789 &amp; @ ? !
    </p>
  </section>
</ReviewLayout>
